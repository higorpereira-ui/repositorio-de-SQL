create table copa_do_mundo (
id serial primary key not null, 
selecao text,
valor_de_mercado int,
ranking_fifa int,
artilheiro text,
grupo_da_copa varchar (1)
);
--chave primaria: indentificador único de uma tabela. Esse informaçâo não pode se repetir em nenhum momento--
--chave estrangeira: A chave primaria que é referencida em outra tabela--
--varchar: É um limitador da quantidade de caracteres. dentro de parenteses e o valor que define o limite--
